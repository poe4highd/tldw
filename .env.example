# tldw 环境配置示例
# 复制此文件为 .env 并填写实际值

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5123

# Cloudflared 隧道配置
TUNNEL_NAME=tldw-backend
# 如果有自己的域名，填写子域名（如 tldw.example.com）
# 留空则使用 trycloudflare.com 临时域名
TUNNEL_HOSTNAME=
# GitHub Gist 自动同步（用于传递隧道地址给前端）
# 1. 创建 Personal Access Token: https://github.com/settings/tokens/new?scopes=gist
# 2. 创建一个 Gist，获取 ID
GITHUB_TOKEN=ghp_your_token_here
GIST_ID=your_gist_id_here