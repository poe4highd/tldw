# YTQuickBite 前端环境变量
# 复制此文件为 .env.local 并填写实际值

# ============================================
# Supabase 配置（必需）
# ============================================
# 从 Supabase Dashboard → Project Settings → API 获取

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# anon public key（也叫 publishable key）
# 这是公开的，可以安全地暴露在前端
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
